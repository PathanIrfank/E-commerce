# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION (backend/.env)
# ==========================================
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Database Connection String
# Note: If left blank or unset during local dev, an in-memory MongoDB will auto-boot!
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecommerce?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_minimum_32_characters_long

# Cloudinary Credentials (For Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Test Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==========================================
# FRONTEND ENVIRONMENT CONFIGURATION (frontend/.env)
# ==========================================
# In local development:
VITE_API_BASE_URL=http://localhost:5000/api

# In production (on Vercel pointing to Render backend):
# VITE_API_BASE_URL=https://your-backend-app.onrender.com/api
